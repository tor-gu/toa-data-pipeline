{
  "Comment": "Tournament of Albums results processing pipeline",
  "StartAt": "ConsolidateNames",
  "States": {
    "ConsolidateNames": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${names_consolidator_arn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.consolidateNamesOutput",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 10,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FinalizeFailure"
        }
      ],
      "Next": "ConsolidateResults"
    },
    "ConsolidateResults": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${consolidator_arn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.consolidateOutput",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 10,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FinalizeFailure"
        }
      ],
      "Next": "CheckIfFilesProcessed"
    },
    "CheckIfFilesProcessed": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.consolidateOutput.Payload.files_processed",
          "NumericGreaterThan": 0,
          "Next": "UpdateScores"
        }
      ],
      "Default": "FinalizeSuccess"
    },
    "UpdateScores": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${scores_updater_arn}",
        "Payload": {
          "earliest_date.$": "$.consolidateOutput.Payload.earliest_date"
        }
      },
      "ResultPath": "$.scoresOutput",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 10,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FinalizeFailure"
        }
      ],
      "Next": "SyncDynamoDB"
    },
    "SyncDynamoDB": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${dynamodb_writer_arn}",
        "Payload": {
          "earliest_date.$": "$.consolidateOutput.Payload.earliest_date"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 10,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FinalizeFailure"
        }
      ],
      "Next": "FinalizeSuccess"
    },
    "FinalizeSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${finalizer_arn}",
        "Payload": {
          "status": "success"
        }
      },
      "End": true
    },
    "FinalizeFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${finalizer_arn}",
        "Payload": {
          "status": "failure",
          "error.$": "$.error"
        }
      },
      "Next": "ExecutionFailed"
    },
    "ExecutionFailed": {
      "Type": "Fail"
    }
  }
}
