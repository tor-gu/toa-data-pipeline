{
  "Comment": "Tournament of Albums results processing pipeline",
  "StartAt": "NormalizeInput",
  "States": {
    "NormalizeInput": {
      "Type": "Choice",
      "Comment": "rebuild defaults to false, so a manual execution can be started with {}.",
      "Choices": [
        {
          "Variable": "$.rebuild",
          "IsPresent": true,
          "Next": "ConsolidateNamesAndResults"
        }
      ],
      "Default": "DefaultRebuildFalse"
    },
    "DefaultRebuildFalse": {
      "Type": "Pass",
      "Result": false,
      "ResultPath": "$.rebuild",
      "Next": "ConsolidateNamesAndResults"
    },
    "ConsolidateNamesAndResults": {
      "Type": "Parallel",
      "Comment": "The two consolidators are independent and write disjoint outputs. ResultSelector reshapes the branch array into the object the downstream states expect -- the indices follow the Branches array, so $[0] is names and $[1] is results. ResultPath is $.consolidated rather than $ so that $.rebuild survives into the later states.",
      "Branches": [
        {
          "StartAt": "ConsolidateNames",
          "States": {
            "ConsolidateNames": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${names_consolidator_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": ["Lambda.TooManyRequestsException"],
                  "IntervalSeconds": 5,
                  "MaxAttempts": 10,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "ConsolidateResults",
          "States": {
            "ConsolidateResults": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${consolidator_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": ["Lambda.TooManyRequestsException"],
                  "IntervalSeconds": 5,
                  "MaxAttempts": 10,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultSelector": {
        "consolidateNamesOutput.$": "$[0]",
        "consolidateOutput.$": "$[1]"
      },
      "ResultPath": "$.consolidated",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FinalizeFailure"
        }
      ],
      "Next": "CheckIfFilesProcessed"
    },
    "CheckIfFilesProcessed": {
      "Type": "Choice",
      "Comment": "A rebuild never short-circuits -- it reprocesses everything already consolidated, so it does not need new files.",
      "Choices": [
        {
          "Variable": "$.rebuild",
          "BooleanEquals": true,
          "Next": "UpdateScores"
        },
        {
          "Variable": "$.consolidated.consolidateOutput.Payload.files_processed",
          "NumericGreaterThan": 0,
          "Next": "UpdateScores"
        }
      ],
      "Default": "FinalizeSuccess"
    },
    "UpdateScores": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${scores_updater_arn}",
        "Payload": {
          "earliest_date.$": "$.consolidated.consolidateOutput.Payload.earliest_date",
          "rebuild.$": "$.rebuild"
        }
      },
      "ResultPath": "$.scoresOutput",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 10,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FinalizeFailure"
        }
      ],
      "Next": "EnrichScores"
    },
    "EnrichScores": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${scores_enricher_arn}",
        "Payload": {}
      },
      "ResultPath": "$.enrichOutput",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 10,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FinalizeFailure"
        }
      ],
      "Next": "BuildStatisticsAndViz"
    },
    "BuildStatisticsAndViz": {
      "Type": "Parallel",
      "ResultPath": "$.parallelOutput",
      "Branches": [
        {
          "StartAt": "BuildStatistics",
          "States": {
            "BuildStatistics": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${statistics_builder_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": ["Lambda.TooManyRequestsException"],
                  "IntervalSeconds": 5,
                  "MaxAttempts": 10,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "BuildViz",
          "States": {
            "BuildViz": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${viz_builder_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": ["Lambda.TooManyRequestsException"],
                  "IntervalSeconds": 5,
                  "MaxAttempts": 10,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FinalizeFailure"
        }
      ],
      "Next": "SyncDynamoDB"
    },
    "SyncDynamoDB": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${dynamodb_writer_arn}",
        "Payload": {
          "earliest_date.$": "$.consolidated.consolidateOutput.Payload.earliest_date",
          "rebuild.$": "$.rebuild"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 10,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FinalizeFailure"
        }
      ],
      "Next": "FinalizeSuccess"
    },
    "FinalizeSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${finalizer_arn}",
        "Payload": {
          "status": "success"
        }
      },
      "End": true
    },
    "FinalizeFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${finalizer_arn}",
        "Payload": {
          "status": "failure",
          "error.$": "$.error"
        }
      },
      "Next": "ExecutionFailed"
    },
    "ExecutionFailed": {
      "Type": "Fail"
    }
  }
}
